<Window x:Class="wpf_workspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_workspace"
        mc:Ignorable="d"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Title="Змейка" Height="675" Width="565"
        Closing="Window_Closing">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="451" Margin="50,109,0,0" VerticalAlignment="Top" Width="451">
            <Canvas Name="GameField" HorizontalAlignment="Left" Height="450" VerticalAlignment="Top" Width="450" Margin="-0.5,-0.5,-0.5,-0.5"/>
        </Border>
        <Label x:Name="CurrentScore" Content="Счёт:" HorizontalAlignment="Left" Margin="50,78,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" Width="76" Height="26"/>
        <Button x:Name="GamePauseSwitch" Content="⏵" HorizontalAlignment="Left" Margin="441,78,0,0" VerticalAlignment="Top" Width="60" Height="26" FontFamily="Arial" Click="GamePauseSwitch_Click" IsEnabled="False"/>
        <TextBox x:Name="NewWallY" HorizontalAlignment="Left" Height="26" Margin="461,565,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="40" IsEnabled="False" PreviewTextInput="NumericYCordValidation" TextChanged="NewWallCords_TextChanged"/>
        <Button x:Name="CreateNewWall" Content="Создать стену" HorizontalAlignment="Left" Margin="366,596,0,0" VerticalAlignment="Top" Width="135" FontFamily="Arial" FontSize="14" Height="26" IsEnabled="False" Click="CreateNewWall_Click"/>
        <Label x:Name="NewWallYLabel" Content="Y" HorizontalAlignment="Left" Margin="436,565,0,0" VerticalAlignment="Top" Height="26" Width="20" FontFamily="Arial" FontSize="14" IsEnabled="False"/>
        <TextBox x:Name="NewWallX" HorizontalAlignment="Left" Height="26" Margin="391,565,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="40" PreviewTextInput="NumericXCordValidation" IsEnabled="False" TextChanged="NewWallCords_TextChanged"/>
        <Label x:Name="NewWallXLabel" Content="X" HorizontalAlignment="Left" Margin="366,565,0,0" VerticalAlignment="Top" Height="26" Width="20" FontFamily="Arial" FontSize="14" IsEnabled="False"/>

        <TextBox x:Name="PlayerName" HorizontalAlignment="Left" Height="26" Margin="106,10,0,0" TextWrapping="Wrap" Text="{Binding PlayerName}" VerticalAlignment="Top" Width="210" FontFamily="Arial" FontSize="14" TextChanged="PlayerName_TextChanged" PreviewTextInput="PlayerName_PreviewTextInput"/>
        <Label Content="Имя игрока" HorizontalAlignment="Left" Margin="11,10,0,0" VerticalAlignment="Top" Height="26" Width="90" FontFamily="Arial" FontSize="14"/>
        <Button x:Name="GameStateSwitch" Content="Начать новую игру" HorizontalAlignment="Left" Margin="375,10,0,0" VerticalAlignment="Top" Height="26" Width="165" Click="GameStateSwitch_Click" FontSize="14" FontFamily="Arial" IsEnabled="False"/>
        <Label x:Name="PersonalBestScore" Content="" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" Height="26" Width="375" FontFamily="Arial"/>
        <Button x:Name="BestPlayerScoresButton" Content="Топ 10 результатов" HorizontalAlignment="Left" Margin="390,41,0,0" VerticalAlignment="Top" Width="150" Height="26" FontSize="14" FontFamily="Arial" Click="BestPlayerScoresButton_Click" x:FieldModifier="public"/>
    </Grid>
</Window>
